---
import PortfolioCard from "./PortfolioCard.astro";
import { sortedPortfolios } from "../data/portfolios";
---
<main>
  {sortedPortfolios.map((p) => <PortfolioCard {...p} />)}
  <p id="empty" hidden>No hay resultados para tu búsqueda.</p>
</main>

<style>
  main { max-width: 1200px; margin: 0 auto; padding: 0 24px 64px; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 24px; align-items: start; }
  #empty { grid-column: 1 / -1; text-align: center; color: var(--muted); padding: 48px 0; font-family: var(--font-mono); }
  #empty[hidden] { display: none; }
  @media (max-width: 640px) { main { padding: 0 16px 48px; gap: 18px; } }
</style>