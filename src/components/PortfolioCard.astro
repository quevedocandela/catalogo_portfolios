---
import type { Portfolio } from "../data/portfolios";
import { getLang } from "../data/languages";

const { name, cover, languages, link } = Astro.props as Portfolio;
const langs = languages.map(getLang);

// Color estable por nombre para el fallback sin portada
let h = 0;
for (const c of name) h = (h * 31 + c.charCodeAt(0)) % 360;
const bg = cover
  ? `background-image:url('${cover}')`
  : `background:linear-gradient(135deg,hsl(${h} 65% 48%),hsl(${(h + 50) % 360} 70% 38%))`;
const search = `${name} ${langs.map((l) => l.label).join(" ")}`.toLowerCase();
---
<article class="card" data-search={search}>
  <div class="cover" style={bg} role="img" aria-label={`Portada de ${name}`}>
    {!cover && name.trim()[0].toUpperCase()}
  </div>
  <div class="info">
    <h2>{name}</h2>
    <ul class="langs" aria-label="Lenguajes">
      {langs.map((l) => (
        <li title={l.label}>
          {l.icon
            ? <img src={l.icon} alt={l.label} width="24" height="24" loading="lazy" />
            : <span class="txt">{l.label}</span>}
        </li>
      ))}
    </ul>
    <a class="btn" href={link} target="_blank" rel="noopener">Ver portfolio</a>
  </div>
</article>

<style>
  .card { background: var(--surface); border: 2px solid var(--line); display: flex; flex-direction: column; transition: transform .15s, box-shadow .15s; }
  .card[hidden] { display: none; }
  .card:hover { transform: translate(-3px, -3px); box-shadow: 6px 6px 0 var(--pink); }
  .cover { aspect-ratio: 4/3; display: grid; place-items: center; font-family: var(--font-pixel); font-size: 2.6rem; color: #fff; background-size: cover; background-position: center; border-bottom: 2px solid var(--line); }
  .info { padding: 16px 18px 20px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
  h2 { font-size: 1.15rem; }
  .langs { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; flex: 1; align-content: flex-start; }
  .langs li { min-width: 40px; height: 40px; padding: 7px; display: grid; place-items: center; background: var(--w, #f1ecff); border: 2px solid var(--line); }
  .langs img { display: block; }
  .txt { font-family: var(--font-mono); font-size: .75rem; font-weight: 700; color: var(--accent-text); padding: 0 4px; }
  .btn { display: block; text-align: center; padding: 10px; background: var(--accent); color: var(--accent-text); text-decoration: none; font-family: var(--font-mono); font-weight: 700; }
  .btn:hover { background: #fff; }
  .btn:focus-visible { outline: 3px solid var(--cyan); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .card { transition: none; } .card:hover { transform: none; } }
</style>