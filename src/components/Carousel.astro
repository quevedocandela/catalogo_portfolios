---
import { slides } from "../data/carousel";
---
<section class="carousel" aria-roledescription="carrusel" aria-label="Imágenes de desarrollo de software">
  <div class="frame">
    <div class="viewport" id="viewport">
      <div class="track" id="track">
        {slides.map((s, i) => (
          <div class="slide" role="group" aria-roledescription="diapositiva" aria-label={`${i + 1} de ${slides.length}`}>
            <img src={s.src} alt={s.alt} loading={i === 0 ? "eager" : "lazy"} draggable="false" />
          </div>
        ))}
      </div>
    </div>
    <button class="nav prev" aria-label="Anterior">‹</button>
    <button class="nav next" aria-label="Siguiente">›</button>
  </div>
  <div class="dots">
    {slides.map((_, i) => <button class="dot" data-i={i} aria-label={`Ir a la imagen ${i + 1}`}></button>)}
  </div>
</section>

<style>
  .carousel { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .frame { position: relative; border: 3px solid var(--yellow); box-shadow: 8px 8px 0 var(--pink); background: var(--surface); }
  /* líneas de pantalla retro */
  .frame::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(0deg, rgba(0,0,0,.12) 0 2px, transparent 2px 4px); }
  .viewport { overflow: hidden; aspect-ratio: 16 / 7; }
  .track { display: flex; height: 100%; transition: transform .6s cubic-bezier(.7, 0, .2, 1); }
  .slide { min-width: 100%; height: 100%; overflow: hidden; background: var(--surface); }
  .slide img { width: 100%; height: 100%; object-fit: cover; display: block; transform-origin: 50% 50%; }
  .slide:nth-child(even) img { transform-origin: 30% 60%; }
  .slide:nth-child(3n) img { transform-origin: 70% 40%; }
  /* zoom lento (efecto Ken Burns) en la imagen activa */
  .slide.active img { animation: zoom 7s ease-out forwards; }
  @keyframes zoom { from { transform: scale(1); } to { transform: scale(1.12); } }

  .nav { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; width: 40px; height: 40px; border: 0; background: var(--yellow); color: var(--accent-text); font-size: 1.6rem; line-height: 1; cursor: pointer; }
  .prev { left: 12px; } .next { right: 12px; }
  .nav:hover { background: #fff; }
  .nav:focus-visible, .dot:focus-visible { outline: 3px solid var(--cyan); outline-offset: 2px; }
  .dots { display: flex; justify-content: center; gap: 10px; margin-top: 22px; }
  .dot { width: 12px; height: 12px; border: 0; padding: 0; background: var(--line); cursor: pointer; }
  .dot.active { background: var(--yellow); }
  @media (max-width: 640px) { .viewport { aspect-ratio: 4 / 3; } }
  @media (prefers-reduced-motion: reduce) { .track { transition: none; } .slide.active img { animation: none; } }
</style>

<script>
  const viewport = document.getElementById("viewport")!;
  const track = document.getElementById("track")!;
  const slideEls = document.querySelectorAll<HTMLElement>(".slide");
  const dots = document.querySelectorAll<HTMLButtonElement>(".dot");
  const carousel = document.querySelector<HTMLElement>(".carousel")!;
  const total = dots.length;
  let index = 0;
  let timer: number | undefined;

  function go(n: number) {
    index = (n + total) % total;
    track.style.transform = `translateX(-${index * 100}%)`;
    dots.forEach((d, i) => d.classList.toggle("active", i === index));
    slideEls.forEach((s, i) => s.classList.toggle("active", i === index));
  }
  function stop() { if (timer) clearInterval(timer); }
  function start() {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    stop();
    timer = window.setInterval(() => go(index + 1), 5500);
  }

  carousel.querySelector(".prev")!.addEventListener("click", () => go(index - 1));
  carousel.querySelector(".next")!.addEventListener("click", () => go(index + 1));
  dots.forEach((d) => d.addEventListener("click", () => go(Number(d.dataset.i))));
  carousel.addEventListener("mouseenter", stop);
  carousel.addEventListener("mouseleave", start);
  carousel.addEventListener("focusin", stop);
  carousel.addEventListener("focusout", start);

  // Deslizar con el dedo en el celular
  let startX = 0;
  viewport.addEventListener("touchstart", (e) => { startX = e.touches[0].clientX; }, { passive: true });
  viewport.addEventListener("touchend", (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 40) go(index + (dx < 0 ? 1 : -1));
  });

  go(0);
  start();
</script>