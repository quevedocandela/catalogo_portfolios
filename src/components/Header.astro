---
interface Props { title: string }
const { title } = Astro.props;
---
<header>
  <h1>{title}</h1>
</header>

<style>
  header { max-width: 1200px; margin: 0 auto; padding: 48px 24px 32px; }
  h1 { font-family: var(--font-pixel); font-size: clamp(1.2rem, 4.5vw, 2.4rem); line-height: 1.3; color: var(--yellow); text-shadow: 3px 3px 0 var(--pink); }
</style>