---
import { sortedPortfolios } from "../data/portfolios";
const total = sortedPortfolios.length;
---
<div class="bar">
  <input id="q" type="search" placeholder="Buscar por nombre o lenguaje" aria-label="Buscar portfolios" autocomplete="off" />
  <span id="count" aria-live="polite">{total} de {total} portfolios</span>
</div>

<style>
  .bar { max-width: 1200px; margin: 0 auto; padding: 24px 24px 24px; display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
  input { flex: 1; min-width: 220px; padding: 12px 16px; border: 2px solid var(--line); background: var(--surface); color: var(--text); font-family: var(--font-mono); font-size: 1rem; }
  input::placeholder { color: var(--muted); }
  input:focus-visible { outline: 3px solid var(--cyan); outline-offset: 2px; }
  #count { color: var(--green); font-family: var(--font-mono); font-size: .9rem; }
  @media (max-width: 640px) { .bar { padding: 20px 16px; } }
</style>

<script>
  // Quita tildes y mayúsculas para que "oscar" encuentre "Óscar"
  const norm = (s: string) => s.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();

  const input = document.getElementById("q") as HTMLInputElement | null;
  const count = document.getElementById("count");
  const empty = document.getElementById("empty");

  function filter() {
    const cards = document.querySelectorAll<HTMLElement>("[data-search]");
    const term = norm(input?.value ?? "");
    let visible = 0;
    cards.forEach((card) => {
      const match = norm(card.dataset.search ?? "").includes(term);
      card.hidden = !match;
      if (match) visible++;
    });
    if (count) count.textContent = `${visible} de ${cards.length} portfolios`;
    if (empty) empty.hidden = visible > 0;
  }

  input?.addEventListener("input", filter);
  filter();
</script>